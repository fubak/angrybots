{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  "exclude": [
    "src/Game.ts",
    "src/systems/**",
    "src/entities/Block.ts",
    "src/entities/GrokBot.ts",
    "src/entities/Pig.ts",
    "src/sling/ballisticArc.ts",
    "src/sling/launchImpulse.ts",
    "src/game/ContactSystem.ts",
    "src/game/SceneQuiescence.ts"
  ]
}
