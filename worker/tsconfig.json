{
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "@cloudflare/workers-types"
    ],
    "lib": [
      "ES2022"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "moduleDetection": "force",
    "resolveJsonModule": true
  },
  "include": [
    "*.ts"
  ]
}
