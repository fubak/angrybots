{
  "name": "angrybots",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:physics": "vitest run tests/physics",
    "test:perf": "vitest run tests/perf",
    "test:e2e": "playwright test",
    "level:check": "tsx tools/level-check.ts",
    "level:solve": "tsx tools/batch-solve.ts",
    "level:rate": "tsx tools/level-rate.ts",
    "lint:forbidden": "node scripts/check-forbidden.mjs",
    "size": "node scripts/size.mjs",
    "verify": "npm run typecheck && npm run lint:forbidden && npm run test:unit && npm run test:physics && npm run level:check",
    "gauntlet": "node scripts/gauntlet-verify.mjs",
    "perf:smoke": "node scripts/perf-smoke.mjs",
    "level:solve:one": "tsx tools/level-solve.ts",
    "level:curve": "tsx tools/level-curve.ts",
    "level:pouch": "tsx tools/pouch-solve.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/howler": "^2.2.13",
    "@types/three": "^0.186.0",
    "playwright": "^1.49.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "planck": "^1.5.0",
    "three": "^0.186.0"
  }
}
